    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource/nunito-sans": "^5.2.7",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "axios": "^1.15.0",
    "i18next": "^25.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-collapsed": "^4.2.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "sass": "^1.77.6",

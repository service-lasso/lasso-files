{
  "$schema": "https://service-lasso.dev/schemas/service.schema.json",
  "id": "files",
  "name": "Files",
  "description": "Filesystem-backed React file manager packaged for Service Lasso.",
  "version": "1.0.0",
  "enabled": true,
  "status": "30",
  "icon": "pi pi-folder",
  "servicelocation": 10,
  "endpoints": [
    {
      "id": "web",
      "kind": "network",
      "label": "Files HTTP API/UI",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 8199,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "base_url",
      "kind": "url",
      "label": "Files base URL",
      "target": "web",
      "url": "http://${endpoint.web.bind}:${endpoint.web.port}",
      "exposure": "local",
      "required": true
    },
    {
      "id": "ui",
      "kind": "url",
      "label": "Files UI",
      "target": "web",
      "url": "http://${endpoint.web.bind}:${endpoint.web.port}/files",
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "health",
      "kind": "url",
      "label": "Files healthcheck",
      "target": "web",
      "url": "http://${endpoint.web.bind}:${endpoint.web.port}/healthcheck",
      "exposure": "local",
      "required": true
    }
  ],
  "healthchecks": [
    {
      "id": "files-http-health",
      "type": "http",
      "url": "${endpoint.health.url}",
      "expected_status": 200,
      "retries": 180,
      "interval": 500
    }
  ],
  "artifact": {
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-files",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "asset": "lasso-files-1.0.0-win32.zip",
        "archive": "zip",
        "command": "./src/server.mjs"
      },
      "linux": {
        "asset": "lasso-files-1.0.0-linux.tar.gz",
        "archive": "tar.gz",
        "command": "./src/server.mjs"
      },
      "darwin": {
        "asset": "lasso-files-1.0.0-darwin.tar.gz",
        "archive": "tar.gz",
        "command": "./src/server.mjs"
      }
    }
  },
  "execconfig": {
    "debuglog": true,
    "execservice": {
      "id": "@node"
    },
    "datapath": "./data",
    "commandline": {
      "win32": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "linux": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "darwin": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "default": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs"
    },
    "env": {
      "NODE_ENV": "production",
      "FILES_PORT": "${endpoint.web.port}",
      "FILES_URL": "${endpoint.base_url.url}",
      "FILES_DATA_PATH": "${SERVICE_DATA_PATH}",
      "FILES_ALLOWED_EXTENSIONS": ".txt,.png,.jpg,.jpeg,.pdf,.doc,.docx,.exe",
      "FILES_BLOCKED_EXTENSIONS": "",
      "FILES_MAXSIZE_MB": "300"
    },
    "globalenv": {
      "FILES_URL": "${endpoint.base_url.url}",
      "FILES_PORT": "${endpoint.web.port}"
    },
    "serviceport": 8199,
    "depend_on": [
      "@node"
    ]
  },
  "updates": {
    "policy": "notify",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-files",
      "channel": "latest"
    }
  }
}

{
  "$schema": "https://service-lasso.dev/schemas/service.schema.json",
  "id": "files",
  "name": "Files",
  "description": "Filesystem-backed React file manager packaged for Service Lasso.",
  "version": "1.0.0",
  "enabled": true,
  "status": "30",
  "icon": "pi pi-folder",
  "servicelocation": 10,
  "artifact": {
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-files",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "asset": "lasso-files-1.0.0-win32.zip",
        "archive": "zip",
        "command": "./src/server.mjs"
      },
      "linux": {
        "asset": "lasso-files-1.0.0-linux.tar.gz",
        "archive": "tar.gz",
        "command": "./src/server.mjs"
      },
      "darwin": {
        "asset": "lasso-files-1.0.0-darwin.tar.gz",
        "archive": "tar.gz",
        "command": "./src/server.mjs"
      }
    }
  },
  "execconfig": {
    "debuglog": true,
    "execservice": {
      "id": "@node"
    },
    "datapath": "./data",
    "commandline": {
      "win32": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "linux": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "darwin": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs",
      "default": "${SERVICE_ARTIFACT_ROOT}/src/server.mjs"
    },
    "env": {
      "NODE_ENV": "production",
      "FILES_PORT": "${SERVICE_PORT}",
      "FILES_URL": "http://127.0.0.1:${SERVICE_PORT}",
      "FILES_DATA_PATH": "${SERVICE_DATA_PATH}",
      "FILES_MAXSIZE_MB": "300"
    },
    "globalenv": {
      "FILES_URL": "http://127.0.0.1:${SERVICE_PORT}",
      "FILES_PORT": "${SERVICE_PORT}"
    },
    "serviceport": 8199,
    "healthcheck": {
      "type": "http",
      "url": "http://127.0.0.1:${SERVICE_PORT}/healthcheck",
      "expected_status": 200,
      "retries": 180,
      "interval_ms": 500
    },
    "depend_on": [
      "@node"
    ]
  },
  "updates": {
    "policy": "notify",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-files",
      "channel": "latest"
    }
  }
}
